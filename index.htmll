<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Versículo del Día</title>

    <!-- 🔒 Bloqueo con contraseña -->
    <script>
        const CONTRASEÑA = "versiculo2026";

        window.onload = function() {
            const ingresada = prompt("🔒 Página privada — Escribe la contraseña:");
            if (ingresada !== CONTRASEÑA) {
                document.body.innerHTML = "<div style='display:flex;justify-content:center;align-items:center;height:100vh;background:#1e3a8a;color:white;text-align:center;'><div><h1>🔒 Acceso denegado</h1><p>Contraseña incorrecta</p></div></div>";
            }
        };
    </script>

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: Arial, sans-serif; }
        body { background: linear-gradient(135deg, #1e3a8a, #3b82f6); min-height: 100vh; color: white; }
        .container { max-width: 900px; margin: 0 auto; padding: 40px 20px; text-align: center; }
        h1 { font-size: 2.5rem; margin-bottom: 10px; }
        .subtitle { font-size: 1.2rem; opacity: 0.9; margin-bottom: 40px; }
        .card { background: white; color: #1e3a8a; border-radius: 20px; padding: 40px; margin: 30px 0; box-shadow: 0 10px 40px rgba(0,0,0,0.2); }
        .card h2 { margin-bottom: 15px; font-size: 1.5rem; }
        .card p { margin-bottom: 25px; line-height: 1.7; }
        .download-btn { display: inline-block; background: #1e40af; color: white; padding: 15px 40px; border-radius: 50px; text-decoration: none; font-size: 1.1rem; font-weight: bold; margin: 10px; }
        .download-btn:hover { background: #1e3a8a; }
        .version { font-size: 0.9rem; opacity: 0.8; margin-top: 10px; }
        footer { margin-top: 50px; opacity: 0.7; font-size: 0.9rem; }
    </style>
</head>
<body>
    <div class="container">
        <h1>📖 Versículo del Día</h1>
        <p class="subtitle">Lleva la Palabra de Dios contigo cada día</p>

        <div class="card">
            <h2>📥 Descargar la App</h2>
            <p>Obtén la aplicación gratuita y recibe un versículo diario con análisis, reflexión y oración.</p>
            <a href="app-armeabi-v7a-release.apk" class="download-btn">📱 Descargar para Android</a>
            <p class="version">Versión 1.0.0 — ✅ Ya disponible!</p>

        <footer>
            <p>© 2026 Versículo del Día — Hecho con ❤️ y fe</p>
        </footer>
    </div>
</body>
</html>

